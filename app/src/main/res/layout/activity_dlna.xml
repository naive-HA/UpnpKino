<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".DlnaActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/tab_selector_container"
            android:layout_width="100dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_tab_selector_container"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:weightSum="3"
            android:padding="2dp"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@+id/menu_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/menu_icon">

            <LinearLayout
                android:id="@+id/tab_settings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center">

                <ImageView
                    android:id="@+id/tab_settings_dot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_dot_outline"
                    android:contentDescription="Settings tab" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_dlna"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center">

                <ImageView
                    android:id="@+id/tab_dlna_dot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_dot_filled"
                    app:tint="@color/label_enabled"
                    android:contentDescription="Control tab" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_transcoding"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center">

                <ImageView
                    android:id="@+id/tab_transcoding_dot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_dot_outline"
                    android:contentDescription="Transcode tab" />
            </LinearLayout>
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/content_group"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="70dp"
            android:fillViewport="true"
            android:clipToPadding="false"
            app:layout_constrainedHeight="true"
            app:layout_constraintWidth_max="600dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tab_selector_container">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="70dp">

                <acab.naiveha.upnpkino.DoubleTapImageView
                    android:id="@+id/imageView"
                    android:layout_width="0dp"
                    android:layout_height="308dp"
                    android:contentDescription="Cast icon"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:srcCompat="@drawable/movie_cast" />

                <ImageView
                    android:id="@+id/info_button"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginTop="36dp"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="@string/info_content_description"
                    android:src="@drawable/info"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/darker_grey" />

                <TextView
                    android:id="@+id/device"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-24dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:lines="2"
                    android:padding="0dp"
                    android:text=""
                    android:textColor="@color/darker_grey"
                    android:textSize="13sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/imageView" />

                <TextView
                    android:id="@+id/media_file"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="56dp"
                    android:layout_marginEnd="32dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:lines="2"
                    android:padding="0dp"
                    android:text="Tap to select media file\n"
                    android:textColor="@color/darker_grey"
                    android:textSize="16sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/device" />

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="44dp"
                    android:layout_marginEnd="32dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/media_file" />

                <ImageView
                    android:id="@+id/loading_spinner"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="Loading indicator"
                    android:elevation="10dp"
                    android:src="@drawable/loading_animation"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@+id/seekBar"
                    app:layout_constraintEnd_toEndOf="@+id/seekBar"
                    app:layout_constraintStart_toStartOf="@+id/seekBar"
                    app:layout_constraintTop_toTopOf="@+id/seekBar"
                    tools:visibility="visible" />

                <LinearLayout
                    android:id="@+id/time_layout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_marginEnd="40dp"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/seekBar">

                    <TextView
                        android:id="@+id/text_position"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:text="00:00:00"
                        android:textColor="@color/darker_grey"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/text_duration"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="00:00:00"
                        android:textColor="@color/darker_grey"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/controls_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/time_layout">

                    <ImageView
                        android:id="@+id/button_stop"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginEnd="24dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Stop"
                        android:focusable="true"
                        android:src="@drawable/stop_circle" />

                    <ImageView
                        android:id="@+id/button_play"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginStart="24dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="Play"
                        android:focusable="true"
                        android:src="@drawable/play_circle" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content_group_settings"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="30dp"
            android:visibility="gone"
            app:layout_constrainedHeight="true"
            app:layout_constraintWidth_max="600dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tab_selector_container">

            <androidx.core.widget.NestedScrollView
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:fillViewport="true"
                android:clipToPadding="false"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/textView3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/label_ssdp_timing"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Discovery &amp; SSDP Timings"
                    android:textColor="@color/label_enabled"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/reset_ssdp"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constrainedWidth="true" />

                <ImageView
                    android:id="@+id/reset_ssdp"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/reset_settings"
                    android:contentDescription="Reset SSDP timing"
                    app:layout_constraintTop_toTopOf="@+id/label_ssdp_timing"
                    app:layout_constraintBottom_toBottomOf="@+id/label_ssdp_timing"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:tint="@color/darker_grey" />

                <TextView
                    android:id="@+id/desc_ssdp_timing"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Timeout duration controlling how long the app listens for M-SEARCH responses from network clients/renderers"
                    android:textColor="@color/darker_grey"
                    android:textSize="13sp"
                    app:layout_constraintTop_toBottomOf="@+id/label_ssdp_timing"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <LinearLayout
                    android:id="@+id/layout_ssdp_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@+id/desc_ssdp_timing"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Timeout: "
                        android:textColor="@color/darker_grey"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/value_ssdp_timing"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8 s"
                        android:textColor="@color/label_enabled"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggle_group_ssdp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    app:checkedButton="@+id/btn_ssdp_8s"
                    app:layout_constraintTop_toBottomOf="@+id/layout_ssdp_value"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_ssdp_5s"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="5s"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_ssdp_8s"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="8s"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_ssdp_15s"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="15s"
                        android:textSize="13sp" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    android:id="@+id/label_buffer_size"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="Socket Receive Buffer Size"
                    android:textColor="@color/label_enabled"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@+id/toggle_group_ssdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/reset_buffer"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constrainedWidth="true" />

                <ImageView
                    android:id="@+id/reset_buffer"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/reset_settings"
                    android:contentDescription="Reset socket buffer size"
                    app:layout_constraintTop_toTopOf="@+id/label_buffer_size"
                    app:layout_constraintBottom_toBottomOf="@+id/label_buffer_size"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:tint="@color/darker_grey" />

                <TextView
                    android:id="@+id/desc_buffer_size"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="On networks with a large number of UPnP/DLNA devices broadcasting SSDP NOTIFY announcements and answering M-SEARCH queries simultaneously, multicast packets arrive in rapid bursts and UDP packets can be lost"
                    android:textColor="@color/darker_grey"
                    android:textSize="13sp"
                    app:layout_constraintTop_toBottomOf="@+id/label_buffer_size"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <LinearLayout
                    android:id="@+id/layout_buffer_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@+id/desc_buffer_size"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Size: "
                        android:textColor="@color/darker_grey"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/value_buffer_size"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="32768 bytes"
                        android:textColor="@color/label_enabled"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggle_group_buffer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    app:checkedButton="@+id/btn_buf_32k"
                    app:layout_constraintTop_toBottomOf="@+id/layout_buffer_value"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_buf_8k"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="8K"
                        android:textSize="11sp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_buf_16k"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="16K"
                        android:textSize="11sp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_buf_32k"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="32K"
                        android:textSize="11sp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_buf_64k"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="64K"
                        android:textSize="11sp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_buf_256k"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="256K"
                        android:textSize="11sp"
                        android:paddingStart="1dp"
                        android:paddingEnd="1dp" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    android:id="@+id/label_datagram_buffer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="Incoming SSDP Datagram Buffer"
                    android:textColor="@color/label_enabled"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@+id/toggle_group_buffer"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/reset_datagram"
                    app:layout_constraintHorizontal_bias="0"
                    app:layout_constrainedWidth="true" />

                <ImageView
                    android:id="@+id/reset_datagram"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="6dp"
                    android:src="@drawable/reset_settings"
                    android:contentDescription="Reset datagram buffer size"
                    app:layout_constraintTop_toTopOf="@+id/label_datagram_buffer"
                    app:layout_constraintBottom_toBottomOf="@+id/label_datagram_buffer"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:tint="@color/darker_grey" />

                <TextView
                    android:id="@+id/desc_datagram_buffer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Some media servers, routers, or smart appliances broadcast extremely verbose SSDP announcements or M-SEARCH requests containing long descriptor URLs, extensive USER-AGENT strings, or custom vendor XML headers and a small buffer can cause the the received packet to be truncated"
                    android:textColor="@color/darker_grey"
                    android:textSize="13sp"
                    app:layout_constraintTop_toBottomOf="@+id/label_datagram_buffer"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <LinearLayout
                    android:id="@+id/layout_datagram_value"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@+id/desc_datagram_buffer"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Size: "
                        android:textColor="@color/darker_grey"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/value_datagram_buffer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4096 bytes"
                        android:textColor="@color/label_enabled"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggle_group_datagram"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    app:checkedButton="@+id/btn_data_4096"
                    app:layout_constraintTop_toBottomOf="@+id/layout_datagram_value"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_data_1500"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="1500"
                        android:textSize="11sp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_data_2048"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="2048"
                        android:textSize="11sp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_data_4096"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="4096"
                        android:textSize="11sp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_data_8192"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="8192"
                        android:textSize="11sp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.core.widget.NestedScrollView>

            <TextView
                android:id="@+id/textView3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="30dp"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:text="UPnP Kino by naiveHA\nhttps://github.com/naive-HA/UpnpKino"
                android:textAlignment="center"
                android:textColor="@color/darker_grey"
                android:textSize="14sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/content_group_transcoding"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="70dp"
            android:visibility="gone"
            app:layout_constrainedHeight="true"
            app:layout_constraintWidth_max="600dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tab_selector_container">

            <TextView
                android:id="@+id/textView2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="30dp"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:text="@string/tips_message"
                android:textAlignment="center"
                android:textColor="@color/darker_grey"
                android:textSize="16sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:id="@+id/menu_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:padding="12dp"
            android:src="@drawable/menu"
            android:contentDescription="Open menu"
            android:elevation="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?android:attr/windowBackground"
        android:clickable="true"
        android:focusable="true">

        <com.google.android.material.navigation.NavigationView
            android:id="@+id/nav_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:headerLayout="@layout/nav_header"
            app:itemVerticalPadding="24dp"
            app:itemTextAppearance="@style/DrawerItemTextAppearance"
            app:menu="@menu/drawer_menu"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/drawer_footer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:background="@android:color/transparent" />

        <LinearLayout
            android:id="@+id/drawer_footer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:elevation="8dp">

            <TextView
                android:id="@+id/textView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="UPnP Kino by naiveHA 1.0.0\nhttps://github.com/naive-HA/UpnpKino"
                android:textAlignment="center"
                android:textColor="@color/darker_grey"
                android:textSize="14sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.drawerlayout.widget.DrawerLayout>
